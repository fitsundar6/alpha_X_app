{
  "name": "alpha-x-gym-backend",
  "version": "1.0.0",
  "description": "Production-ready backend API for Alpha X Gym",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "hash-password": "ts-node src/utils/hash_password.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "alpha-x-gym",
    "fitness",
    "typescript",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Alpha X Gym Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@prisma/client": "^6.4.1",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
